SERVICENOW_INSTANCE_URL=https://your-company.service-now.com

# Supported values: basic or oauth
SERVICENOW_AUTH_TYPE=oauth
SERVICENOW_USERNAME=your.work.username
SERVICENOW_PASSWORD=replace_me

# Required when SERVICENOW_AUTH_TYPE=oauth
SERVICENOW_CLIENT_ID=replace_me
SERVICENOW_CLIENT_SECRET=replace_me
SERVICENOW_TOKEN_URL=https://your-company.service-now.com/oauth_token.do

SERVICENOW_TIMEOUT=30
SERVICENOW_TLS_VERIFY=true

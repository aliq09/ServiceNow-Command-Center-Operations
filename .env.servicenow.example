SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_AUTH_TYPE=basic
SERVICENOW_USERNAME=your.username
SERVICENOW_PASSWORD=replace_me
SERVICENOW_TIMEOUT=30

# Keep certificate verification enabled unless a development PDI requires
# the temporary compatibility workaround.
SERVICENOW_TLS_VERIFY=true
